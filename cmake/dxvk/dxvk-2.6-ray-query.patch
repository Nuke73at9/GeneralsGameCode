diff --git a/src/dxvk/dxvk_adapter.cpp b/src/dxvk/dxvk_adapter.cpp
index 11adc0e..a96e866 100644
--- a/src/dxvk/dxvk_adapter.cpp
+++ b/src/dxvk/dxvk_adapter.cpp
@@ -311,6 +311,33 @@ namespace dxvk {
     if (m_deviceInfo.vk12.driverID == VK_DRIVER_ID_QUALCOMM_PROPRIETARY)
       devExtensions.extMultiDraw.setMode(DxvkExtMode::Disabled);
 
+    // Acceleration structures and ray queries, for an application's own Vulkan passes on this
+    // device through the D3D9 interop: only when the application asks (DXVK_ENABLE_RAY_QUERY=1)
+    // and the device has them, with buffer device addresses, which they need. Off, the device
+    // is made as before.
+    bool enableRayQuery = env::getEnvVar("DXVK_ENABLE_RAY_QUERY") == "1"
+      && m_deviceExtensions.supports(devExtensions.khrAccelerationStructure.name())
+      && m_deviceExtensions.supports(devExtensions.khrDeferredHostOperations.name())
+      && m_deviceExtensions.supports(devExtensions.khrRayQuery.name())
+      && m_deviceFeatures.khrAccelerationStructure.accelerationStructure
+      && m_deviceFeatures.khrRayQuery.rayQuery
+      && m_deviceFeatures.vk12.bufferDeviceAddress;
+
+    enabledFeatures.khrAccelerationStructure = { };
+    enabledFeatures.khrRayQuery = { };
+
+    if (enableRayQuery) {
+      devExtensions.khrAccelerationStructure.setMode(DxvkExtMode::Optional);
+      devExtensions.khrDeferredHostOperations.setMode(DxvkExtMode::Optional);
+      devExtensions.khrRayQuery.setMode(DxvkExtMode::Optional);
+
+      enabledFeatures.khrAccelerationStructure.accelerationStructure = VK_TRUE;
+      enabledFeatures.khrRayQuery.rayQuery = VK_TRUE;
+      enabledFeatures.vk12.bufferDeviceAddress = VK_TRUE;
+    } else if (env::getEnvVar("DXVK_ENABLE_RAY_QUERY") == "1") {
+      Logger::warn("DxvkAdapter: Ray queries requested, but the device does not support them");
+    }
+
     DxvkNameSet extensionsEnabled;
 
     if (!m_deviceExtensions.enableExtensions(
@@ -521,6 +548,24 @@ namespace dxvk {
     VkDevice device = VK_NULL_HANDLE;
     VkResult vr = m_vki->vkCreateDevice(m_handle, &info, nullptr, &device);
 
+    if (vr != VK_SUCCESS && enableRayQuery) {
+      Logger::err("DxvkAdapter: Failed to create device, retrying without ray queries");
+
+      extensionsEnabled.disableExtension(devExtensions.khrAccelerationStructure);
+      extensionsEnabled.disableExtension(devExtensions.khrDeferredHostOperations);
+      extensionsEnabled.disableExtension(devExtensions.khrRayQuery);
+
+      enabledFeatures.khrAccelerationStructure.accelerationStructure = VK_FALSE;
+      enabledFeatures.khrRayQuery.rayQuery = VK_FALSE;
+      enabledFeatures.vk12.bufferDeviceAddress = enableCudaInterop;
+
+      extensionNameList = extensionsEnabled.toNameList();
+      info.enabledExtensionCount      = extensionNameList.count();
+      info.ppEnabledExtensionNames    = extensionNameList.names();
+
+      vr = m_vki->vkCreateDevice(m_handle, &info, nullptr, &device);
+    }
+
     if (vr != VK_SUCCESS && enableCudaInterop) {
       // Enabling certain Vulkan extensions can cause device creation to fail on
       // Nvidia drivers if a certain kernel module isn't loaded, but we cannot know
@@ -970,6 +1015,16 @@ namespace dxvk {
       m_deviceFeatures.extVertexAttributeDivisor.pNext = std::exchange(m_deviceFeatures.core.pNext, &m_deviceFeatures.extVertexAttributeDivisor);
     }
 
+    if (m_deviceExtensions.supports(VK_KHR_ACCELERATION_STRUCTURE_EXTENSION_NAME)) {
+      m_deviceFeatures.khrAccelerationStructure.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ACCELERATION_STRUCTURE_FEATURES_KHR;
+      m_deviceFeatures.khrAccelerationStructure.pNext = std::exchange(m_deviceFeatures.core.pNext, &m_deviceFeatures.khrAccelerationStructure);
+    }
+
+    if (m_deviceExtensions.supports(VK_KHR_RAY_QUERY_EXTENSION_NAME)) {
+      m_deviceFeatures.khrRayQuery.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_RAY_QUERY_FEATURES_KHR;
+      m_deviceFeatures.khrRayQuery.pNext = std::exchange(m_deviceFeatures.core.pNext, &m_deviceFeatures.khrRayQuery);
+    }
+
     if (m_deviceExtensions.supports(VK_KHR_EXTERNAL_MEMORY_WIN32_EXTENSION_NAME))
       m_deviceFeatures.khrExternalMemoryWin32 = VK_TRUE;
 
@@ -1062,6 +1117,9 @@ namespace dxvk {
       &devExtensions.extSwapchainMaintenance1,
       &devExtensions.extTransformFeedback,
       &devExtensions.extVertexAttributeDivisor,
+      &devExtensions.khrAccelerationStructure,
+      &devExtensions.khrDeferredHostOperations,
+      &devExtensions.khrRayQuery,
       &devExtensions.khrExternalMemoryWin32,
       &devExtensions.khrExternalSemaphoreWin32,
       &devExtensions.khrMaintenance5,
@@ -1201,6 +1259,16 @@ namespace dxvk {
       enabledFeatures.extVertexAttributeDivisor.pNext = std::exchange(enabledFeatures.core.pNext, &enabledFeatures.extVertexAttributeDivisor);
     }
 
+    if (devExtensions.khrAccelerationStructure) {
+      enabledFeatures.khrAccelerationStructure.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ACCELERATION_STRUCTURE_FEATURES_KHR;
+      enabledFeatures.khrAccelerationStructure.pNext = std::exchange(enabledFeatures.core.pNext, &enabledFeatures.khrAccelerationStructure);
+    }
+
+    if (devExtensions.khrRayQuery) {
+      enabledFeatures.khrRayQuery.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_RAY_QUERY_FEATURES_KHR;
+      enabledFeatures.khrRayQuery.pNext = std::exchange(enabledFeatures.core.pNext, &enabledFeatures.khrRayQuery);
+    }
+
     if (devExtensions.khrExternalMemoryWin32)
       enabledFeatures.khrExternalMemoryWin32 = VK_TRUE;
 
@@ -1376,6 +1444,10 @@ namespace dxvk {
       "\n" << VK_EXT_VERTEX_ATTRIBUTE_DIVISOR_EXTENSION_NAME <<
       "\n  vertexAttributeInstanceRateDivisor     : " << (features.extVertexAttributeDivisor.vertexAttributeInstanceRateDivisor ? "1" : "0") <<
       "\n  vertexAttributeInstanceRateZeroDivisor : " << (features.extVertexAttributeDivisor.vertexAttributeInstanceRateZeroDivisor ? "1" : "0") <<
+      "\n" << VK_KHR_ACCELERATION_STRUCTURE_EXTENSION_NAME <<
+      "\n  accelerationStructure                  : " << (features.khrAccelerationStructure.accelerationStructure ? "1" : "0") <<
+      "\n" << VK_KHR_RAY_QUERY_EXTENSION_NAME <<
+      "\n  rayQuery                               : " << (features.khrRayQuery.rayQuery ? "1" : "0") <<
       "\n" << VK_KHR_EXTERNAL_MEMORY_WIN32_EXTENSION_NAME <<
       "\n  extension supported                    : " << (features.khrExternalMemoryWin32 ? "1" : "0") <<
       "\n" << VK_KHR_EXTERNAL_SEMAPHORE_WIN32_EXTENSION_NAME <<
